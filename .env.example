# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The start scripts (start.ps1 / start.sh) create `.env` for you with random passwords.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# True for running on your own laptop. Production servers must use False.
DJANGO_DEBUG=True
# Comma-separated. The leading dot allows all subdomains (tenants).
DJANGO_ALLOWED_HOSTS=localhost,.localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://*.localhost:8000
# Only used when DJANGO_DEBUG=False.
DJANGO_SECURE_SSL_REDIRECT=True

# Root domain of the platform. Tenants get <slug>.<PLATFORM_DOMAIN>.
# On a laptop, *.localhost works in most browsers without DNS changes.
PLATFORM_DOMAIN=localhost
TIME_ZONE=Pacific/Auckland
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=businessos
POSTGRES_USER=businessos
POSTGRES_PASSWORD=change-me
# Inside Docker the host is `db`. For a local Python run use `localhost`.
DATABASE_URL=postgres://businessos:change-me@db:5432/businessos

# --- Redis (cache and Celery) ---
REDIS_URL=redis://redis:6379/0
# How often the automatic "Check system" runs (minutes). Optional.
# SYSTEM_CHECK_EVERY_MINUTES=60

# --- Secret vault master key ---
# Encrypts every API key the businesses save. The start scripts create it for you.
# BACK IT UP somewhere safe (for example a password manager). If it is lost,
# saved API keys cannot be opened and must be entered again.
# Format: id:base64-of-32-random-bytes. To rotate, put a new key first and
# keep the old one after it, e.g. "k2:NEW...,k1:OLD...", then run rotate_vault_key.
VAULT_MASTER_KEYS=
# --- Backups (task 1.14) ---
# Encrypts the platform's full backups. The start scripts create it for you.
# BACK IT UP outside this computer, together with VAULT_MASTER_KEYS: without it the
# backups cannot be opened. Format like the vault key: id:base64-of-32-random-bytes.
# To rotate, put a new key first and keep the old one after it: "b2:NEW...,b1:OLD...".
BACKUP_ENCRYPTION_KEYS=
# Optional (defaults shown): keep every backup 7 days, then one a day for 30 days,
# then one a month for 12 months; test a restore every 7 days.
# BACKUP_KEEP_ALL_DAYS=7
# BACKUP_KEEP_DAILY_DAYS=30
# BACKUP_KEEP_MONTHLY=12
# BACKUP_RESTORE_TEST_EVERY_DAYS=7

# Development only: allow connections to private-network addresses (e.g. a local Ollama).
ALLOW_PRIVATE_NETWORK_URLS=False

# --- Email ---
# Emails are sent through the Gmail connection saved on the Integrations page
# (see user guide 4.7), not through settings here. Without one, emails are
# printed in the web container's log (docker compose logs web).

# --- Docker image version (latest = newest build of main) ---
APP_IMAGE_TAG=latest
